# SMTP account used to send email OTPs


# Used to sign login tokens and hash OTPs
JWT_SECRET=replace-with-a-long-random-secret

# Use a no-reply mailbox for all OTP and order notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Fitting4U <no-reply@example.com>"

# Optional recipient for vendor order updates.
ORDER_VENDOR_EMAIL=vendor@example.com
