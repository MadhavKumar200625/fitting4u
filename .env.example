# SMTP account used to send email OTPs


# Used to sign login tokens and hash OTPs
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay API credentials; use the matching test or live credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# Set this same value in the Razorpay webhook's Secret field.
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-webhook-secret
NEXT_PUBLIC_BASE_URL=https://www.fitting4u.com

# Use a no-reply mailbox for all OTP and order notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Fitting4U <no-reply@example.com>"

# Optional recipient for vendor order updates.
ORDER_VENDOR_EMAIL=vendor@example.com
